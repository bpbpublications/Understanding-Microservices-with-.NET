{
  "ReverseProxy": {
    "Routes": {
      "products": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/products/{**rest}"
        },
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "catalog-window"
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5080/"
          }
        }
      }
    }
  }
}
